{
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "preact"
  },
  "imports": {
    "preact": "npm:preact@^10",
    "preact/": "npm:/preact@^10/",
    "@testing-library/preact": "npm:@testing-library/preact@^3",
    "@happy-dom/global-registrator": "npm:@happy-dom/global-registrator",
    "@std/assert": "jsr:@std/assert@^1",
    "@std/testing": "jsr:@std/testing@^1"
  },
  "tasks": {
    "tests": "deno test -A --no-check",
    "tauri:dev": "GSK_RENDERER=gl WEBKIT_DISABLE_DMABUF_RENDERER=1 RUST_BACKTRACE=full deno run tauri dev"
  }
}
